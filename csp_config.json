{
  "results_dir": "xlsx_pipeline_results",
  "embedder": "bge-m3",
  "pa_embedder": null,
  "sa_embedder": null,
  "device": "cuda:0",
  "openai_api_key": null,
  "alignment_params": {
    "similarity_threshold": 0.65,
    "length_penalty": 0.1,
    "distance_decay": 0.08,
    "boundary_bonus": 0.2,
    "particle_bonus": 0.25,
    "comma_bonus": 0.15,
    "dp_window": 4,
    "sim_gamma": 1.4,
    "hanja_bonus": 0.3,
    "hanja_strict": true
  },
  "thresholds": {
    "pa": {
      "unit": "row",
      "metrics": [
        "partial_match",
        "target_avg_similarity"
      ],
      "levels": {
        "min": {
          "partial_match": 0.1,
          "target_avg_similarity": 0.1
        },
        "recommended": {
          "partial_match": 0.15,
          "target_avg_similarity": 0.19
        },
        "top": {
          "partial_match": 0.21,
          "target_avg_similarity": 0.26
        }
      }
    },
    "sa": {
      "unit": "row",
      "metrics": [
        "partial_match",
        "target_avg_similarity"
      ],
      "levels": {
        "min": {
          "partial_match": 0.885,
          "target_avg_similarity": 0.769
        },
        "recommended": {
          "partial_match": 0.952,
          "target_avg_similarity": 0.905
        },
        "top": {
          "partial_match": 1.0,
          "target_avg_similarity": 1.0
        }
      }
    }
  },
  "p2s_selection_params": {
    "candidate_prior_bonus_by_prefix": {
      "supar(": 0.42,
      "boundary(": 0.4
    },
    "boundary_style_prior": {
      "enabled": true,
      "weight_terminal": 0.006,
      "weight_continuation": -0.01,
      "continuation_tokens": [
        "하며",
        "하며,",
        "하고",
        "하야",
        "하여",
        "하야,",
        "하여,"
      ],
      "continuation_tail_cjk": [
        "而",
        "以",
        "則",
        "乃",
        "故",
        "及",
        "與",
        "且"
      ],
      "terminal_suffixes": [
        "이라",
        "矣라",
        "也라",
        "耳라",
        "니라",
        "로라",
        "哉아",
        "邪아"
      ],
      "terminal_punct": [
        ".",
        "!",
        "?",
        "。",
        "！",
        "？"
      ]
    },
    "penalty_short_pairs": {
      "long_tgt_threshold": 40,
      "short_src_threshold": 12,
      "penalty_per_pair": 0.015
    },
    "penalty_empty_src": 0.5,
    "max_candidates_multiplier": 12,
    "whitespace_dp_penalties": {
      "long_tgt_threshold": 80,
      "short_src_threshold": 25,
      "very_short_src_threshold": 8,
      "penalty_short": 0.07,
      "penalty_very_short": 0.09,
      "ratio_outlier": {
        "min_tgt_len": 80,
        "ratio_high_threshold": 3.8,
        "ratio_mid_threshold": 3.2,
        "median_margin_high": 1.2,
        "median_margin_mid": 1.0,
        "src_len_cap_high": 45,
        "src_len_cap_mid": 35,
        "penalty_high": 0.18,
        "penalty_mid": 0.12,
        "penalty_longest_shortest": 0.1
      }
    },
    "disable_supar": false,
    "disable_boundary": false,
    "disable_whitespace_dp": false
  },
  "pa": {
    "boundary_threshold": 0.7
  }
