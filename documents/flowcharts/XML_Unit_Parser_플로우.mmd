---
title: XML 단위 파서 구문 분석 모듈
---
flowchart TD
    %% 고대비 색상 스타일 정의
    classDef startEnd fill:#2e7d32,stroke:#1b5e20,stroke-width:3px,color:#ffffff,font-weight:bold
    classDef process fill:#1976d2,stroke:#0d47a1,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef decision fill:#f57c00,stroke:#e65100,stroke-width:2px,color:#000000,font-weight:bold
    classDef validation fill:#558b2f,stroke:#2e7d32,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef extraction fill:#7b1fa2,stroke:#4a148c,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef error fill:#d32f2f,stroke:#b71c1c,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef metadata fill:#00796b,stroke:#004d40,stroke-width:2px,color:#ffffff,font-weight:bold
    
    A[📄 XML 파일 입력]:::startEnd --> B[✅ XML 형식 검증]:::validation
    B --> C{유효한 XML?}:::decision
    
    C -->|아니오| D[❌ 오류: 무효한 XML]:::error
    C -->|예| E[🌳 XML 트리 파싱]:::process
    
    E --> F[📋 메타데이터 추출]:::metadata
    F --> G[🔍 텍스트 단위 찾기]:::extraction
    G --> H[🏷️ 단위 유형 식별]:::process
    
    H --> I{📋 단위 유형}:::decision
    I -->|문단| J[📑 PA 단위 추출]:::extraction
    I -->|문장| K[📝 SA 단위 추출]:::extraction
    I -->|혼합| L[🔄 두 유형 모두 추출]:::extraction
    
    J --> M[🗂️ JTI 코드 매핑 적용]:::process
    K --> M
    L --> M
    
    M --> N[✅ 단위 무결성 검증]:::validation
    N --> O[📦 단위 객체 생성]:::process
    O --> P[📤 파싱된 단위 반환]:::process
    P --> Q[✅ 완료]:::startEnd
    
    subgraph "📋 메타데이터 추출"
        F1[📄 문서 ID]:::metadata
        F2[Title Information]
        F3[Author Details]
        F4[Creation Date]
        F5[File Version]
        F --> F1
        F --> F2
        F --> F3
        F --> F4
        F --> F5
    end
    
    subgraph "Unit Object Structure"
        O1[Unit ID]
        O2[Text Content]
        O3[Position Info]
        O4[Type Classification]
        O5[Quality Score]
        O --> O1
        O --> O2
        O --> O3
        O --> O4
        O --> O5
    end
    
    subgraph "Validation Checks"
        N1[Text Length Check]
        N2[Encoding Validation]
        N3[Structure Integrity]
        N4[Duplicate Detection]
        N --> N1
        N --> N2
        N --> N3
        N --> N4
    end

    style A fill:#4caf50
    style D fill:#f44336
    style Q fill:#f44336
    style C fill:#ff9800
    style I fill:#ff9800