---
title: XML 파일 브라우저 관리 모듈
---
flowchart TD
    %% 고대비 색상 스타일 정의
    classDef startEnd fill:#2e7d32,stroke:#1b5e20,stroke-width:3px,color:#ffffff,font-weight:bold
    classDef process fill:#1976d2,stroke:#0d47a1,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef decision fill:#f57c00,stroke:#e65100,stroke-width:2px,color:#000000,font-weight:bold
    classDef sort fill:#7b1fa2,stroke:#4a148c,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef validation fill:#558b2f,stroke:#2e7d32,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef error fill:#d32f2f,stroke:#b71c1c,stroke-width:2px,color:#ffffff,font-weight:bold
    
    A[🚀 파일 브라우저 시작]:::startEnd --> B[📂 루트 디렉토리 스캔]:::process
    B --> C[🔍 XML 파일 필터링]:::process
    C --> D[🔐 파일 권한 확인]:::validation
    
    D --> E[🌳 파일 트리 구축]:::process
    E --> F[📊 정렬 기준 적용]:::process
    F --> G{정렬 방식}:::decision
    
    G -->|이름| H[📝 파일명으로 정렬]:::sort
    G -->|날짜| I[📅 수정일로 정렬]:::sort
    G -->|크기| J[📏 파일크기로 정렬]:::sort
    G -->|유형| K[📁 파일유형으로 정렬]:::sort
    
    H --> L[📋 파일 목록 생성]:::process
    I --> L
    J --> L
    K --> L
    
    L --> M[✅ 파일 무결성 검증]:::validation
    M --> N{파일 유효?}:::decision
    
    N -->|무효| O[❌ 오류 표시]:::error
    N -->|유효| P[📋 처리 대기열 추가]:::process
    
    O --> Q[📝 오류 세부정보 로그]:::error
    P --> R[⭐ 파일 우선순위 계산]:::process
    
    Q --> S[Continue to Next File]
    R --> S
    S --> T{More Files?}
    
    T -->|Yes| M
    T -->|No| U[Return File List]
    U --> V[End]
    
    subgraph "File Filtering Criteria"
        C1[File Extension (.xml)]
        C2[File Size Limits]
        C3[Encoding Check]
        C4[Last Modified Date]
        C5[Access Permissions]
        C --> C1
        C --> C2
        C --> C3
        C --> C4
        C --> C5
    end
    
    subgraph "File Validation Checks"
        M1[XML Well-formedness]
        M2[Schema Validation]
        M3[Encoding Detection]
        M4[Corruption Check]
        M5[Accessibility Check]
        M --> M1
        M --> M2
        M --> M3
        M --> M4
        M --> M5
    end
    
    subgraph "Priority Calculation Factors"
        R1[File Size Weight]
        R2[Last Modified Weight]
        R3[Processing History]
        R4[User Priority Tags]
        R5[Error Frequency]
        R --> R1
        R --> R2
        R --> R3
        R --> R4
        R --> R5
    end
    
    subgraph "Error Logging"
        Q1[File Path Recording]
        Q2[Error Type Classification]
        Q3[Timestamp Logging]
        Q4[Suggested Actions]
        Q --> Q1
        Q --> Q2
        Q --> Q3
        Q --> Q4
    end

    style A fill:#4caf50
    style V fill:#f44336
    style G fill:#ff9800
    style N fill:#ff9800
    style T fill:#ff9800